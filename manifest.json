{
  "manifest_version": 3,
  "name": "Voice Reminder — Keep Focus",
  "version": "1.1.4",
  "description": "A Chrome extension that delivers custom voice reminders at regular intervals to help you stay focused.",
  "permissions": [
    "storage",
    "alarms",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/brain-16.png",
      "32": "icons/brain-32.png",
      "48": "icons/brain-48.png",
      "128": "icons/brain-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/brain-16.png",
    "32": "icons/brain-32.png",
    "48": "icons/brain-48.png",
    "128": "icons/brain-128.png"
  }
}
